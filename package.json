{
  "name": "uzh-map-project",
  "version": "1.0.0",
  "description": "UZH Map Project - Frontend and Backend",
  "private": true,
  "scripts": {
    "setup": "npm run setup:frontend && npm run setup:backend",
    "setup:frontend": "cd map_uzhorod && npm install",
    "setup:backend": "cd uzh-map-backend && npm install",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd map_uzhorod && npm run build",
    "build:backend": "cd uzh-map-backend && npm run build",
    "build:prod": "npm run build:frontend:prod && npm run build:backend:prod",
    "build:frontend:prod": "cd map_uzhorod && npm run build:prod",
    "build:backend:prod": "cd uzh-map-backend && npm run build",
    "start": "npm run start:frontend",
    "start:frontend": "cd map_uzhorod && npm run serve",
    "start:backend": "cd uzh-map-backend && npm run start:dev",
    "start:dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "cd map_uzhorod && npm run lint",
    "lint:backend": "cd uzh-map-backend && npm run lint",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build",
    "docker:rebuild": "docker-compose build --no-cache",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose restart"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}

