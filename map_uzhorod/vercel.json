{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run serve",
  "installCommand": "npm install",
  "framework": "vue",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://uzh-map-vue.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}

